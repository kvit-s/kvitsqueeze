// Windows resources compiled into kvitsqueeze.exe.
//
// The window and the tray icon are set at run time from AppIcon::application().
// This is the other half: the icon Explorer, the taskbar and the Start Menu
// shortcut read straight out of the binary, without running it. Both come from
// the same drawing — kvitsqueeze.ico is generated by tools/make-appicon.cpp.
//
// The lowest-numbered icon resource is the one the shell treats as the
// application icon, so this stays IDI_ICON1 and stays first.
IDI_ICON1 ICON "kvitsqueeze.ico"
