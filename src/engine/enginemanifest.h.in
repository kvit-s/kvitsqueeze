//
// Generated by CMake from packaging/engine-manifest.txt. Do not edit, and do
// not add it to the tree — the copy in packaging/ is the one that matters.
//
// This is the fallback for an unreachable GitHub, and nothing more. The
// published manifest is preferred at runtime for the reason spelled out in
// packaging/engine-manifest.txt: upstream prunes old builds, so editing that
// file and pushing repairs every copy of the app already on a disk, while a
// value compiled in here can only be repaired by a new release.
//
// The Inno Setup installer carries the same fallback for the same reason.

#pragma once

inline const char *sqzBundledEngineManifest()
{
    return R"SQZMANIFEST(@SQZ_ENGINE_MANIFEST_TEXT@)SQZMANIFEST";
}
