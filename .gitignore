# Local credentials. Keep shareable templates under an .example name.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
.netrc

# Build
build/
# Preset build trees (CMakePresets.json binaryDir pattern)
build-*/
# CTest scratch left by in-source ctest runs
Testing/
tools/__pycache__/

# Windows helper output
win-test-result.txt
windeploy.log

# The audio engine binary is fetched, not committed: it is upstream
# squeezelite, pinned by version and checksum in packaging/engine-version.txt
# and staged into engine/ at deploy time.
#
# Anchored with a leading slash. Unanchored, `engine/` matches at any depth
# and silently swallows src/engine/ — the whole audio-engine module.
/engine/
packaging/windows/squeezelite*.exe
# fetch-engine.ps1 drops upstream's licence text beside whatever it downloads.
packaging/windows/LICENSE.squeezelite.txt

# Qt Creator
*.pro.user
*.autosave
CMakeLists.txt.user

# IDE
.vscode/
.idea/
*.swp
*~

# Compiled
*.o
*.a
*.so
moc_*
qrc_*
*_autogen/

# OS
.DS_Store
Thumbs.db
.clauding

# Packaging outputs
dist/

# Working documents, deliberately not published.
#
# The specification, the progress log and the launch checklist stay local: they
# are the project's internal record, and they carry network and library detail
# that has no reason to be public. Source comments still cite them by
# requirement id (FR-x.y, NFR-n, Nn, Dn) — see CONTRIBUTING.md, which restates
# every invariant a contributor actually needs.
spec/
CLAUDE.md
